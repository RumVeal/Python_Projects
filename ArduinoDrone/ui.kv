#:import dp kivy.metrics.dp
#:import Window kivy.core.window.Window

<RoundedButton@Button>:
    background_normal: ""
    background_down: ""
    background_color: 1, 1, 1, 0
    color: 1, 1, 1, 1
    font_size: 35
    canvas.before:
        Color:
            rgba: (0.20, 0.60, 1, 1) if self.state == "normal" else (0.10, 0.40, 0.9, 1)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [self.width/4]

<RoundedControlButton@Button>:
    background_normal: ""
    background_down: ""
    background_color: 0.20, 0.60, 1, 0
    color: 1, 1, 1, 1
    font_size: "18sp"
    size_hint_y: None
    height: Window.height * 0.125
    canvas.before:
        Color:
            rgba: 0.20, 0.60, 1, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [24] 

<EllipseButton@Button>:
    background_normal: ""
    background_down: ""
    background_color: 1, 1, 1, 0
    size_hint: None, None
    pos_hint: {"center_x": 0.5, "center_y": 0.75}
    size: (min(Window.width, Window.height) * 0.40, min(Window.width, Window.height) * 0.40)
    btn_color: 0.7, 0, 0, 1
    canvas.before:
        Color:
            rgba: self.btn_color
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [self.width/2]
 
<DPad@GridLayout>:
    rows: 3
    cols: 3
    size_hint: None, None
    size: (min(Window.width, Window.height) * 0.30, min(Window.width, Window.height) * 0.30)
    spacing: dp(0)
    row_force_default: True
    row_default_height: min(Window.width, Window.height) * 0.10
    col_force_default: True
    col_default_width: min(Window.width, Window.height) * 0.10

    Widget:
    RoundedButton:
        text: "^"
        on_release: app.forward()
    Widget:

    RoundedButton:
        text: "<"
        on_release: app.left()
    Widget:
    RoundedButton:
        text: ">"
        on_release: app.right()

    Widget:
    RoundedButton:
        text: "v"
        on_release: app.backward()
    Widget:




FloatLayout:
    canvas.before:
        Color:
            rgba: 0.2, 0.2, 0.3, 1
        Rectangle:
            pos: (self.width/4, dp(0))
            size: (self.width/2, self.height)
    EllipseButton:
        id: power_btn
        text: "OFF"
        btn_color: 0.7, 0, 0, 1
        on_release: app.on_off(self)
    DPad:
        size_hint: None, None
        pos_hint: {"center_x":0.40625, "center_y":15/56}

    
    BoxLayout:
        orientation: "vertical"
        size_hint: None, None
        width: min(Window.width, Window.height) * 0.20
        height: self.minimum_height
        pos_hint: {"center_x": 0.625, "center_y": 15/56}
        spacing: Window.height/30

        RoundedControlButton:
            text: "UP"
            on_press: self.canvas.before.children[0].rgba = (0.10, 0.40, 0.9, 1)
            on_release:
                self.canvas.before.children[0].rgba = (0.20, 0.60, 1, 1)
                app.up()

        RoundedControlButton:
            text: "DOWN"
            on_press: self.canvas.before.children[0].rgba = (0.10, 0.40, 0.9, 1)
            on_release:
                self.canvas.before.children[0].rgba = (0.20, 0.60, 1, 1)
                app.down()
